FROM apache/airflow:2.9.3-python3.11

USER root

# Java is required for PySpark (local mode); chromium+chromedriver for Selenium parsers
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        openjdk-17-jre-headless \
        curl \
        chromium \
        chromium-driver && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV SPARK_JARS=/opt/airflow/jars
ENV CHROME_BIN=/usr/bin/chromium
ENV CHROMEDRIVER_PATH=/usr/bin/chromedriver
ENV SELENIUM_HEADLESS=1

RUN mkdir -p ${SPARK_JARS} && \
    curl -L -o ${SPARK_JARS}/postgresql-42.7.3.jar \
    https://jdbc.postgresql.org/download/postgresql-42.7.3.jar

USER airflow

COPY requirements.txt /opt/airflow/repo-requirements.txt
RUN pip install --no-cache-dir -r /opt/airflow/repo-requirements.txt

RUN pip install --no-cache-dir pyspark==3.5.1 psycopg2-binary